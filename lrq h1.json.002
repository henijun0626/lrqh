  "ludoQuestions": [
    {
      "bankId": 1,
      "text": "如果我们一起去旅行，你最想去哪里，为什么？",
      "type": "both_answer",
      "id": 1
    },
    {
      "bankId": 1,
      "text": "你认为一段完美的关系中，最不可或缺的三个要素是什么？",
      "type": "both_answer",
      "id": 2
    },
    {
      "bankId": 1,
      "text": "分享一件最近因为我而让你感到心动或开心的小事。",
      "type": "both_answer",
      "id": 3
    },
    {
      "bankId": 1,
      "text": "回忆一下，我们第一次见面时，你对我的第一印象是什么？",
      "type": "both_answer",
      "id": 4
    },
    {
      "bankId": 1,
      "text": "如果我们可以一起学习一项新技能，你希望是什么？",
      "type": "both_answer",
      "id": 5
    },
    {
      "bankId": 1,
      "text": "描述一个你最希望和我一起度过的完美周末。",
      "type": "both_answer",
      "id": 6
    },
    {
      "bankId": 1,
      "text": "你觉得我们之间最有默契的一件事是什么？",
      "type": "both_answer",
      "id": 7
    },
    {
      "bankId": 1,
      "text": "如果用一种动物来形容我，你觉得是什么？为什么？",
      "type": "both_answer",
      "id": 8
    },
    {
      "bankId": 1,
      "text": "在未来的一年里，你最想和我一起完成的一件事是什么？",
      "type": "both_answer",
      "id": 9
    },
    {
      "bankId": 1,
      "text": "分享一部你最近很喜欢、并且想推荐给我一起看的电影或剧。",
      "type": "both_answer",
      "id": 10
    },
    {
      "bankId": 1,
      "text": "我们下次约会，你希望穿什么风格的衣服？",
      "type": "both_answer",
      "id": 11
    },
    {
      "bankId": 1,
      "text": "描述一下我最让你心动的一个瞬间。",
      "type": "single_answer",
      "id": 12
    },
    {
      "bankId": 1,
      "text": "诚实地说，我做的哪件事曾经让你偷偷生过气？",
      "type": "single_answer",
      "id": 13
    },
    {
      "bankId": 1,
      "text": "如果我有一种超能力，你希望是什么？",
      "type": "single_answer",
      "id": 14
    },
    {
      "bankId": 1,
      "text": "给我三个最贴切的标签。",
      "type": "single_answer",
      "id": 15
    },
    {
      "bankId": 1,
      "text": "在你心里，我的形象和你的理想型有多接近？",
      "type": "single_answer",
      "id": 16
    },
    {
      "bankId": 1,
      "text": "分享一个你觉得我可能不知道的，关于你的小秘密。",
      "type": "single_answer",
      "id": 17
    },
    {
      "bankId": 1,
      "text": "如果我们的故事是一首歌，你觉得歌名应该叫什么？",
      "type": "single_answer",
      "id": 18
    },
    {
      "bankId": 1,
      "text": "说一件你觉得我做得比你好/更擅长的事情。",
      "type": "single_answer",
      "id": 19
    },
    {
      "bankId": 1,
      "text": "如果可以回到我们认识的任意一天，你会选择哪一天，想做什么？",
      "type": "single_answer",
      "id": 20
    },
    {
      "bankId": 1,
      "text": "用三个词来形容你眼中的我们的关系。",
      "type": "single_answer",
      "id": 21
    }
